{
  "manifest_version": 3,
  "name": "Copy Task for Azure DevOps",
  "version": "1.1.2",
  "description": "Copia work items como commits e identifica projetos na seleção de vínculos do Azure DevOps.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Copy Task — módulos",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": [
        "ModuleSettings.js",
        "CopyTask.js",
        "PR_WorkItem_CopyTask.js",
        "RelatedWorkProjects.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
